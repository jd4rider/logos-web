---
interface Props {
  current?: "home" | "pricing" | "download" | "try" | "support";
}

const { current = "home" } = Astro.props;

const links = [
  { href: "/", label: "Product", key: "home" },
  { href: "/try", label: "Try It Now", key: "try" },
  { href: "/pricing", label: "Pricing", key: "pricing" },
  { href: "/download", label: "Download", key: "download" },
  { href: "/support", label: "Support", key: "support" },
  { href: "https://docs.logos-ai.online", label: "Docs", key: "docs" },
  { href: "https://blog.logos-ai.online", label: "Blog", key: "blog" },
];
---

<div class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-grid-fade grid-frame opacity-[0.08]"></div>
  <div class="pointer-events-none absolute left-[-8rem] top-10 h-72 w-72 rounded-full bg-gold/10 blur-3xl"></div>
  <div class="pointer-events-none absolute right-[-6rem] top-28 h-72 w-72 rounded-full bg-accent/10 blur-3xl"></div>

  <header class="sticky top-0 z-40 border-b border-white/5 bg-bg/80 backdrop-blur-xl">
    <div class="shell flex items-center justify-between gap-4 py-4">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/logos-logo.png"
          alt="Logos AI"
          width="56"
          height="56"
          class="h-14 w-14 rounded-2xl border border-gold/20 bg-white/5 object-cover shadow-[0_0_24px_rgba(245,191,82,0.2)]"
        />
        <div>
          <div class="font-display text-xl text-text">Logos AI</div>
          <div class="text-xs uppercase tracking-[0.22em] text-muted">Bible study for web and desktop</div>
        </div>
      </a>

      <nav class="hidden items-center gap-1 lg:flex">
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              current === link.key && "bg-white/5 text-text",
            ]}
            target={link.href.startsWith("https://") ? "_blank" : undefined}
            rel={link.href.startsWith("https://") ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href="/try" class="hidden md:inline-flex cta-secondary">Open reader</a>
        <a href="/download" class="cta-primary">Download app</a>
      </div>
    </div>
  </header>

  <slot />

  <footer class="border-t border-white/5 py-10">
    <div class="shell flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex items-center gap-4">
        <img
          src="/logos-logo.png"
          alt="Logos AI"
          width="64"
          height="64"
          class="h-16 w-16 rounded-2xl border border-gold/20 bg-white/5 object-cover shadow-[0_0_24px_rgba(245,191,82,0.16)]"
        />
        <div>
        <div class="font-display text-2xl text-text">Logos AI</div>
        <p class="mt-2 max-w-2xl text-sm leading-7 text-muted">
          Read Scripture online, compare translations, and move deeper with the desktop app, local AI, and richer study
          tools when you are ready.
        </p>
        </div>
      </div>

      <div class="flex max-w-3xl flex-col gap-3 text-sm text-muted md:items-end">
        <div class="flex flex-wrap gap-3">
          <a href="/support" class="nav-link">Support Logos AI</a>
          <a href="/pricing" class="nav-link">Pricing</a>
          <a href="/download" class="nav-link">Download</a>
          <a href="https://docs.logos-ai.online" target="_blank" rel="noreferrer" class="nav-link">Docs</a>
          <a href="https://blog.logos-ai.online" target="_blank" rel="noreferrer" class="nav-link">Blog</a>
          <a href="https://github.com/jd4rider/logos" target="_blank" rel="noreferrer" class="nav-link">GitHub Repo</a>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/sponsors/jd4rider" target="_blank" rel="noreferrer" class="nav-link">GitHub Sponsors</a>
          <a href="https://buymeacoffee.com/jd4rider" target="_blank" rel="noreferrer" class="nav-link">Buy Me a Coffee</a>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:jd4rider@gmail.com" class="nav-link">Setup Plans: jd4rider@gmail.com</a>
          <a href="tel:+14063967246" class="nav-link">Call or Text: 406-396-7246</a>
        </div>
      </div>
    </div>
  </footer>
</div>
